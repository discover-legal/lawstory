+/**
+ * Apply `fn` to every string in a generated document (sections, fullText,
+ * htmlContent), in place. Plain objects and arrays only: the document's
+ * Date timestamp and other class instances are left alone.
+ */
+function mapDocumentStrings(node, fn) {
+  if (typeof node === 'string') return fn(node);
+  if (Array.isArray(node)) return node.map((v) => mapDocumentStrings(v, fn));
+  if (node && Object.getPrototypeOf(node) === Object.prototype) {
+    for (const k of Object.keys(node)) node[k] = mapDocumentStrings(node[k], fn);
+  }
+  return node;
+}
+
+/**
+ * "child(ren)" is a drafting hedge for an unknown count. Once the interview
+ * has recorded the children, the document says "child" or "children".
+ */
+function settleChildNoun(doc, data) {
+  const n = Array.isArray(data && data.children) ? data.children.length : 0;
+  if (n === 0) return doc;
+  const noun = n === 1 ? 'child' : 'children';
+  return mapDocumentStrings(doc, (s) => s.replace(/child\(ren\)/g, noun));
+}
+
 module.exports = {
